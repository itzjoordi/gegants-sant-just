---
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import { gegants, getGegantImage } from "../../utils/gegants";
import type { Gegant } from "../../utils/gegants";
import { absoluteSrc, absoluteUrl, withBase } from "../../utils/url";

export function getStaticPaths() {
  return gegants.map((gegant) => ({
    params: { slug: gegant.slug },
    props: { gegant },
  }));
}

interface Props {
  gegant: Gegant;
}

const { gegant } = Astro.props;
const image = getGegantImage(gegant.image);
const others = gegants.filter((other) => other.slug !== gegant.slug);

const ogImage = await getImage({
  src: image,
  width: 1200,
  height: 630,
  format: "jpg",
  quality: 80,
});
const ogImageUrl = absoluteSrc(ogImage.src);

const title = `${gegant.name} (${gegant.year}) | Colla Gegantera de Sant Just Desvern`;
const pageUrl = absoluteUrl(`/gegants/${gegant.slug}/`);
const orgId = absoluteUrl("/#organitzacio");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "VisualArtwork",
    name: gegant.name,
    description: gegant.history,
    dateCreated: String(gegant.year),
    creator: { "@type": "Person", name: gegant.builder },
    artform: "Gegant",
    image: ogImageUrl,
    url: pageUrl,
    owner: { "@id": orgId },
    isPartOf: { "@id": orgId },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inici", item: absoluteUrl("/") },
      {
        "@type": "ListItem",
        position: 2,
        name: "Gegants",
        item: absoluteUrl("/#gegants"),
      },
      { "@type": "ListItem", position: 3, name: gegant.name, item: pageUrl },
    ],
  },
];
---

<Layout
  title={title}
  description={gegant.summary}
  image={ogImageUrl}
  imageAlt={gegant.alt}
  type="article"
  jsonLd={jsonLd}
>
  <main
    id="contingut"
    tabindex="-1"
    class="focus:outline-none pt-24 md:pt-[136px] pb-[72px] md:pb-[120px]"
  >
    <Container>
      <nav aria-label="Ruta de navegació">
        <ol class="flex flex-wrap items-center gap-x-2 text-[15px] text-muted">
          <li>
            <a href={withBase("/")} class="text-link hover:underline">Inici</a>
          </li>
          <li aria-hidden="true">›</li>
          <li>
            <a href={withBase("/#gegants")} class="text-link hover:underline">
              Gegants
            </a>
          </li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" class="text-ink">{gegant.name}</li>
        </ol>
      </nav>

      <header class="flex flex-col gap-5 md:gap-6 mt-8 md:mt-12">
        <h1
          class="text-[44px] md:text-[80px] leading-[1.07] md:leading-[1.05] font-bold tracking-[-0.03em] md:tracking-[-0.035em] text-balance"
        >
          {gegant.name}
        </h1>
        <dl class="flex flex-wrap gap-x-10 gap-y-4 text-[17px]">
          <div>
            <dt class="text-[13px] font-semibold uppercase tracking-[0.06em] text-muted">
              Any d’estrena
            </dt>
            <dd class="mt-1 text-ink">{gegant.year}</dd>
          </div>
          <div>
            <dt class="text-[13px] font-semibold uppercase tracking-[0.06em] text-muted">
              Constructor
            </dt>
            <dd class="mt-1 text-ink">{gegant.builder}</dd>
          </div>
          <div>
            <dt class="text-[13px] font-semibold uppercase tracking-[0.06em] text-muted">
              Taller
            </dt>
            <dd class="mt-1 text-ink">{gegant.workshop}</dd>
          </div>
        </dl>
      </header>

      <div class="mt-10 md:mt-14 flex justify-center rounded-[22px] md:rounded-[28px] bg-mist overflow-hidden">
        <Image
          src={image}
          alt={gegant.alt}
          width={960}
          widths={[480, 720, 960]}
          sizes="(min-width: 1072px) 480px, calc(100vw - 48px)"
          quality={80}
          loading="eager"
          class="w-full max-w-[480px] h-auto"
        />
      </div>

      <div class="mt-10 md:mt-14 max-w-[720px]">
        <p class="text-[19px] md:text-2xl leading-[1.4] md:leading-[1.35] text-muted text-pretty">
          {gegant.history}
        </p>
      </div>

      <section aria-labelledby="fonts-title" class="mt-12 md:mt-16">
        <h2
          id="fonts-title"
          class="text-2xl md:text-[32px] leading-[1.15] font-bold tracking-[-0.02em]"
        >
          Fonts
        </h2>
        <ul class="mt-4 flex flex-col gap-1">
          {
            gegant.sources.map((source) => (
              <li>
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center min-h-11 text-[17px] text-link hover:underline"
                >
                  {source.label}
                  <span class="sr-only"> (s'obre en una pestanya nova)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="altres-title" class="mt-12 md:mt-16">
        <h2
          id="altres-title"
          class="text-2xl md:text-[32px] leading-[1.15] font-bold tracking-[-0.02em]"
        >
          Altres gegants
        </h2>
        <ul class="mt-4 flex flex-col gap-1">
          {
            others.map((other) => (
              <li>
                <a
                  href={withBase(`/gegants/${other.slug}/`)}
                  class="inline-flex items-center min-h-11 text-[17px] text-link hover:underline"
                >
                  {other.name} ({other.year})
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="mt-12 md:mt-16">
        <a
          href={withBase("/#gegants")}
          class="inline-flex items-center gap-1 h-11 text-[17px] text-link hover:underline"
        >
          <span aria-hidden="true">‹</span>
          Tornar als gegants
        </a>
      </p>
    </Container>
  </main>
</Layout>
