---
import Container from "./Container.astro";
---

<div id="inici" class="pt-16 md:pt-[112px]">
  <Container width="wide">
    <div class="flex flex-col items-center gap-3.5 md:gap-5 text-center">
      <p class="text-[15px] md:text-[17px] font-semibold text-blue tracking-[0.01em]">
        Des de 1984
      </p>
      <h1 class="flex flex-col items-center text-ink max-w-[980px]">
        <span
          class="font-script font-bold text-blue text-[64px] md:text-[120px] leading-[1] tracking-normal"
        >
          Colla Gegantera
        </span>
        <span
          class="text-[36px] md:text-[64px] leading-[1.07] md:leading-[1.05] font-bold tracking-[-0.03em] md:tracking-[-0.035em] text-balance"
        >
          de Sant&nbsp;Just&nbsp;Desvern.
        </span>
      </h1>
      <p
        class="text-[19px] md:text-2xl leading-[1.4] md:leading-[1.35] text-muted max-w-[640px] text-pretty"
      >
        Fem ballar gegants i capgrossos per tot el territori català.
      </p>
      <div
        class="flex flex-col md:flex-row gap-3.5 md:gap-7 items-center mt-3 md:mt-4"
      >
        <a
          href="#gegants"
          class="flex items-center h-11 px-[22px] rounded-full bg-blue text-white text-[17px]"
        >
          Coneix els gegants
        </a>
        <a
          href="#contacte"
          class="flex items-center gap-1 h-11 md:h-auto text-[17px] text-link"
        >
          Contacta’ns
          <svg
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4.5 2.5 8 6l-3.5 3.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
    <div class="flex justify-center pt-10 md:pt-[72px] pb-[72px] md:pb-[120px]">
      <img
        src="/portada.webp"
        alt="La colla amb els gegants"
        class="w-full max-w-[358px] md:max-w-[1024px] aspect-[358/240] md:aspect-[1024/648] object-cover rounded-[20px] md:rounded-[28px]"
      />
    </div>
  </Container>
</div>
