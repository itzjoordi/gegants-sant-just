---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Container from "./Container.astro";

// Cover slideshow: every image in src/assets/portada, ordered by the number
// in its filename (portada-1 = oldest, highest = most recent).
const coverModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/portada/*.{webp,jpg,jpeg,png}",
  { eager: true }
);
const covers = Object.entries(coverModules)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod]) => mod.default);
---

<div id="inici" class="pt-16 md:pt-[112px]">
  <Container width="wide">
    <div class="flex flex-col items-center gap-3.5 md:gap-5 text-center">
      <p class="text-[15px] md:text-[17px] font-semibold text-blue tracking-[0.01em]">
        Des de 1984
      </p>
      <h1 class="flex flex-col items-center text-ink max-w-[980px]">
        <span
          class="font-script font-bold text-blue text-[64px] md:text-[120px] leading-[1] tracking-normal"
        >
          Colla Gegantera
        </span>
        <span
          class="text-[36px] md:text-[64px] leading-[1.07] md:leading-[1.05] font-bold tracking-[-0.03em] md:tracking-[-0.035em] text-balance"
        >
          de Sant&nbsp;Just&nbsp;Desvern.
        </span>
      </h1>
      <p
        class="text-[19px] md:text-2xl leading-[1.4] md:leading-[1.35] text-muted max-w-[640px] text-pretty"
      >
        Fem ballar gegants i capgrossos per tot el territori català.
      </p>
      <div
        class="flex flex-col md:flex-row gap-3.5 md:gap-7 items-center mt-3 md:mt-4"
      >
        <a
          href="#gegants"
          class="flex items-center h-11 px-[22px] rounded-full bg-blue text-white text-[17px]"
        >
          Coneix els gegants
        </a>
        <a
          href="#contacte"
          class="flex items-center gap-1 h-11 md:h-auto text-[17px] text-link"
        >
          Contacta’ns
          <svg
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4.5 2.5 8 6l-3.5 3.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
    <div class="flex justify-center pt-10 md:pt-[72px] pb-[72px] md:pb-[120px]">
      <div
        id="cover-slideshow"
        role="img"
        aria-label="La colla amb els gegants al llarg dels anys"
        class="relative w-full max-w-[1024px] aspect-[358/240] md:aspect-[1024/648] overflow-hidden isolate rounded-[20px] md:rounded-[28px] bg-mist"
      >
        {
          covers.map((cover, index) => (
            <Image
              src={cover}
              alt=""
              width={Math.min(cover.width, 2048)}
              widths={[640, 1024, 1600, 2048].filter((w) => w <= cover.width)}
              sizes="(min-width: 1072px) 1024px, calc(100vw - 48px)"
              quality={75}
              loading={index === 0 ? "eager" : "lazy"}
              data-cover-slide
              data-active={index === 0 ? "true" : "false"}
              class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-[1200ms] ease-in-out data-[active=true]:opacity-100"
            />
          ))
        }
      </div>
    </div>
  </Container>
</div>

<script>
  const INTERVAL_MS = 3500;
  let timer: number | undefined;

  function startCoverSlideshow() {
    stopCoverSlideshow();
    const root = document.getElementById("cover-slideshow");
    if (!root) return;

    const slides = Array.from(
      root.querySelectorAll<HTMLElement>("[data-cover-slide]")
    );
    if (slides.length < 2) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let current = 0;
    timer = window.setInterval(() => {
      if (document.hidden) return;
      slides[current].dataset.active = "false";
      current = (current + 1) % slides.length;
      slides[current].dataset.active = "true";
    }, INTERVAL_MS);
  }

  function stopCoverSlideshow() {
    if (timer !== undefined) window.clearInterval(timer);
    timer = undefined;
  }

  document.addEventListener("astro:page-load", startCoverSlideshow);
  document.addEventListener("astro:before-swap", stopCoverSlideshow);
</script>
