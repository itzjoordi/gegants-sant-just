---
import { withBase } from "../utils/url";

const navLinks: {
  href: string;
  label: string;
  target?: "_blank";
}[] = [
  { href: withBase("/#inici"), label: "Inici" },
  { href: withBase("/#gegants"), label: "Gegants" },
  {
    href: "https://ca.wikipedia.org/wiki/Gegants_de_Sant_Just_Desvern",
    target: "_blank",
    label: "Història",
  },
  { href: withBase("/#contacte"), label: "Contacte" },
];

import Container from "./Container.astro";
import SocialLinks from "./SocialLinks.astro";
---

<header
  class="fixed top-0 z-50 w-full h-[48px] md:h-[52px] bg-canvas/80 backdrop-blur-xl backdrop-saturate-150 border-b border-black/[0.08]"
>
  <Container>
    <nav
      aria-label="Principal"
      class="flex h-[48px] md:h-[52px] items-center justify-between"
    >
      <a href={withBase("/")} class="flex flex-1 items-center">
        <img
          src={withBase("/logo_escut_transparent.webp")}
          width="376"
          height="211"
          class="h-[26px] md:h-[30px] w-auto"
          alt=""
        />
        <span class="sr-only">Colla Gegantera de Sant Just Desvern – Inici</span>
      </a>

      <ul class="hidden md:flex items-center gap-9 text-[13px] tracking-[-0.01em] text-ink">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.target}
                rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
                class="hover:text-link transition-colors"
              >
                {link.label}
                {link.target === "_blank" && (
                  <span class="sr-only"> (s'obre en una pestanya nova)</span>
                )}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-1 items-center justify-end">
        <SocialLinks iconSize={17} class="md:-mr-3" />
        <button
          id="nav-toggle"
          type="button"
          class="md:hidden flex items-center justify-center w-11 h-11 -mr-2 text-ink"
          aria-controls="nav-panel"
          aria-expanded="false"
        >
          <span id="nav-toggle-label" class="sr-only">Obre el menú</span>
          <svg
            id="nav-toggle-icon"
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M3 7h14M3 13h14"></path>
          </svg>
        </button>
      </div>
    </nav>
  </Container>

  <div
    id="nav-panel"
    class="hidden md:hidden bg-canvas/95 backdrop-blur-xl border-b border-black/[0.08]"
  >
    <ul class="flex flex-col px-6 py-2 text-[15px] text-ink">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.target}
              rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
              class="block py-3"
            >
              {link.label}
              {link.target === "_blank" && (
                <span class="sr-only"> (s'obre en una pestanya nova)</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  function initNavbar() {
    const toggle = document.getElementById("nav-toggle");
    const panel = document.getElementById("nav-panel");
    const label = document.getElementById("nav-toggle-label");
    if (!toggle || !panel) return;

    const setState = (isOpen: boolean) => {
      panel.classList.toggle("hidden", !isOpen);
      toggle.setAttribute("aria-expanded", String(isOpen));
      if (label) label.textContent = isOpen ? "Tanca el menú" : "Obre el menú";
    };

    toggle.addEventListener("click", () => {
      setState(toggle.getAttribute("aria-expanded") !== "true");
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setState(false));
    });
  }

  // Registered once (module scripts run once); elements are looked up on use
  // because the header is re-created on every view transition.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const toggle = document.getElementById("nav-toggle");
    if (!toggle || toggle.getAttribute("aria-expanded") !== "true") return;
    toggle.click();
    toggle.focus();
  });

  document.addEventListener("astro:page-load", initNavbar);
</script>
