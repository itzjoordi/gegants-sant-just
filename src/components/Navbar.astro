---
const navLinks: {
  href: string;
  label: string;
  target?: "_blank";
}[] = [
  { href: "/#inici", label: "Inici" },
  { href: "/#gegants", label: "Gegants" },
  {
    href: "https://ca.wikipedia.org/wiki/Gegants_de_Sant_Just_Desvern",
    target: "_blank",
    label: "Història",
  },
  { href: "/#contacte", label: "Contacte" },
];

import Container from "./Container.astro";
---

<header
  class="fixed top-0 z-50 w-full h-[48px] md:h-[52px] bg-canvas/80 backdrop-blur-xl backdrop-saturate-150 border-b border-black/[0.08]"
>
  <Container>
    <nav
      class="flex h-[48px] md:h-[52px] items-center justify-between"
    >
      <a href="/" class="flex items-center">
        <img
          src="/logo_escut_transparent.webp"
          class="h-[26px] md:h-[30px] w-auto"
          alt="Escut Colla Gegantera"
        />
      </a>

      <ul class="hidden md:flex items-center gap-9 text-[13px] tracking-[-0.01em] text-ink">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.target}
                rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
                class="hover:text-link transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        id="nav-toggle"
        type="button"
        class="md:hidden flex items-center justify-center w-11 h-11 -mr-2 text-ink"
        aria-controls="nav-panel"
        aria-expanded="false"
      >
        <span class="sr-only">Obre el menú</span>
        <svg
          id="nav-toggle-icon"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 7h14M3 13h14"></path>
        </svg>
      </button>
    </nav>
  </Container>

  <div
    id="nav-panel"
    class="hidden md:hidden bg-canvas/95 backdrop-blur-xl border-b border-black/[0.08]"
  >
    <ul class="flex flex-col px-6 py-2 text-[15px] text-ink">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.target}
              rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
              class="block py-3"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  function initNavbar() {
    const toggle = document.getElementById("nav-toggle");
    const panel = document.getElementById("nav-panel");
    if (!toggle || !panel) return;

    const close = () => {
      panel.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
    };

    const open = () => {
      panel.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "true");
    };

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      expanded ? close() : open();
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", close);
    });
  }

  document.addEventListener("astro:page-load", initNavbar);
</script>
