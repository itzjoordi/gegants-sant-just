---
import Container from "./Container.astro";
import gegants from "./Data/gegants.json";
---

<div id="gegants" class="bg-mist py-[72px] md:py-[120px]">
  <Container width="wide">
    <div class="flex flex-col gap-2 md:gap-3 mb-8 md:mb-14">
      <h2
        class="text-4xl md:text-[56px] leading-[1.1] md:leading-[1.07] font-bold tracking-[-0.025em] md:tracking-[-0.03em]"
      >
        Els gegants.
      </h2>
      <p class="text-[19px] md:text-2xl text-muted md:tracking-[-0.01em]">
        Coneix-los i descobreix la seva història.
      </p>
    </div>

    <!-- Desktop / tablet grid -->
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        gegants.map((gegant) => (
          <a
            href={gegant.link[0]}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative block h-[420px] rounded-[22px] overflow-hidden isolate bg-mist focus:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-mist"
          >
            <img
              src={gegant.image}
              alt={gegant.name1}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 [transition-timing-function:cubic-bezier(0.2,0.8,0.2,1)] group-hover:scale-105 group-focus-within:scale-105"
            />
            <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(10,12,28,0.62)_0%,rgba(10,12,28,0)_42%)]" />
            <div class="absolute inset-0 opacity-0 transition-opacity duration-[450ms] ease-out group-hover:opacity-100 group-focus-within:opacity-100 bg-[linear-gradient(to_top,rgba(10,12,28,0.88)_0%,rgba(10,12,28,0.35)_60%,rgba(10,12,28,0.1)_100%)]" />
            <div class="absolute inset-x-0 bottom-0 p-[22px] flex flex-col gap-1.5 text-white">
              <p class="text-xs font-semibold uppercase tracking-[0.06em] text-yellow">
                {gegant.tag}
              </p>
              <h3 class="text-2xl leading-[1.15] font-bold tracking-[-0.02em]">
                {gegant.name1}
              </h3>
              <div class="flex flex-col gap-3 pt-1 opacity-0 translate-y-[10px] transition-[opacity,transform] duration-[450ms] ease-out group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:translate-y-0">
                <p class="text-[15px] leading-[1.45] text-white/80 text-pretty">
                  {gegant.summary}
                </p>
                <span class="flex items-center gap-1 text-[15px] font-medium">
                  Més informació
                  <svg
                    width="11"
                    height="11"
                    viewBox="0 0 12 12"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M4.5 2.5 8 6l-3.5 3.5"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Mobile carousel -->
    <div class="md:hidden -mx-6">
      <div
        id="gegants-carousel"
        class="flex gap-3 overflow-x-auto snap-x snap-mandatory px-6 pb-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
      >
        {
          gegants.map((gegant) => (
            <div
              data-gegant-card
              class="shrink-0 w-[280px] snap-start flex flex-col gap-3.5"
            >
              <img
                src={gegant.image}
                alt={gegant.name1}
                loading="lazy"
                decoding="async"
                class="w-[280px] h-[400px] object-cover object-top rounded-[22px]"
              />
              <div class="flex flex-col gap-1 px-1">
                <p class="text-xs font-semibold uppercase tracking-[0.06em] text-gold">
                  {gegant.tag}
                </p>
                <h3 class="text-[22px] leading-[1.2] font-bold tracking-[-0.02em]">
                  {gegant.name1}
                </h3>
                <p class="text-[15px] leading-[1.45] text-muted text-pretty">
                  {gegant.summary}
                </p>
                <a
                  href={gegant.link[0]}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1 h-11 text-[15px] text-link"
                >
                  Més informació
                  <svg
                    width="11"
                    height="11"
                    viewBox="0 0 12 12"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M4.5 2.5 8 6l-3.5 3.5"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </div>
      <div class="flex justify-center gap-2 mt-4" aria-hidden="true">
        {
          gegants.map((_, i) => (
            <div
              class="dot w-2 h-2 rounded-full bg-[#c7c7cc] data-[active=true]:bg-ink transition-colors"
              data-index={i}
              data-active={i === 0}
            />
          ))
        }
      </div>
    </div>
  </Container>
</div>

<script>
  function initGegantsCarousel() {
    const carousel = document.getElementById("gegants-carousel");
    if (!carousel) return;

    const cards = Array.from(
      carousel.querySelectorAll<HTMLElement>("[data-gegant-card]")
    );
    const dots = Array.from(document.querySelectorAll<HTMLElement>(".dot"));
    if (!cards.length || !dots.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const index = cards.indexOf(entry.target as HTMLElement);
          if (index === -1) return;
          dots.forEach((dot, i) => {
            dot.setAttribute("data-active", String(i === index));
          });
        });
      },
      { root: carousel, threshold: 0.6 }
    );

    cards.forEach((card) => observer.observe(card));
  }

  document.addEventListener("astro:page-load", initGegantsCarousel);
</script>
